{
  "name": "@terrasub-solarda/contracts",
  "version": "1.0.0",
  "description": "Zod Schemas and API contracts for TerraSub & Solar-Da v3",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "schemas": "npm run build && node scripts/export-schemas.mjs",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "zod-to-json-schema": "^3.23.5"
  }
}
