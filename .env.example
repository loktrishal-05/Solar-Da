# Copy to .env (gitignored). Never commit real keys. Every variable is optional.
PORT=3001

# Gemini for the farm assistant and the agents' LLM steps. Without it the offline advisor answers.
GEMINI_API_KEY=

# Free phone alerts through a Telegram bot (docs/DECISIONS.md D15)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Free key from data.gov.in (register, My Account) for live Tamil Nadu mandi prices in the assistant
DATA_GOV_API_KEY=

# Firebase Realtime Database for the Automation page (docs/DECISIONS.md D20). Without it a local store with the same layout stands in,
# labelled "simulated". Example: https://my-project-default-rtdb.firebaseio.com  (FIREBASE_AUTH = database secret or ID token, optional)
FIREBASE_DB_URL=
FIREBASE_AUTH=

# Set to 0 on a real deployment to switch off the one-click demo accounts
SOLARDA_DEMO_LOGIN=1
