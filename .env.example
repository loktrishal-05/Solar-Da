# Copy to .env (gitignored). Never commit real keys.
PORT=3001
# Optional: Gemini key for the future LLM gateway (current gateway is a keyword mock)
GEMINI_API_KEY=

# Optional: free real phone alerts through a Telegram bot (see docs/DECISIONS.md D15)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: free key from data.gov.in (register, My Account) for real Tamil Nadu mandi prices in the assistant
DATA_GOV_API_KEY=
