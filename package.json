{
  "name": "solarda",
  "version": "3.0.0",
  "description": "Solarda: safety-gated AI farm agents (monorepo: safety engine, API, web app, contracts)",
  "private": true,
  "workspaces": [
    "packages/*",
    "weiqou/*"
  ],
  "scripts": {
    "build:engine": "npm run build --workspace=@terrasub-solarda/engine",
    "test:engine": "npm run test --workspace=@terrasub-solarda/engine",
    "build:contracts": "npm run build --workspace=@terrasub-solarda/contracts",
    "build": "npm run build:engine && npm run build:contracts && npm run build --workspace=weiqou/api && npm run build --workspace=weiqou/web",
    "dev:api": "npm run dev --workspace=weiqou/api",
    "dev:web": "npm run dev --workspace=weiqou/web",
    "dev": "npm run build && concurrently \"npm:dev:api\" \"npm:dev:web\""
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.18.2"
  },
  "license": "MIT"
}
